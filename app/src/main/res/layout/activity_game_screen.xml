<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ImageView
        android:id="@+id/imageTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/image_background"
        android:contentDescription="@string/top_image"
        android:importantForAccessibility="yes"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/spacing_small" />

    <View
        android:id="@+id/overlayTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/imageTop"
        app:layout_constraintBottom_toBottomOf="@id/imageTop"
        app:layout_constraintStart_toStartOf="@id/imageTop"
        app:layout_constraintEnd_toEndOf="@id/imageTop" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/imageTop"
        app:layout_constraintBottom_toTopOf="@id/imageBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/image_background"
        android:contentDescription="@string/bottom_image"
        android:importantForAccessibility="yes"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_small" />

    <View
        android:id="@+id/overlayBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/imageBottom"
        app:layout_constraintBottom_toBottomOf="@id/imageBottom"
        app:layout_constraintStart_toStartOf="@id/imageBottom"
        app:layout_constraintEnd_toEndOf="@id/imageBottom" />

</androidx.constraintlayout.widget.ConstraintLayout>